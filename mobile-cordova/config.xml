<?xml version='1.0' encoding='utf-8'?>
<widget id="com.nanokeyboardcontroller.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Keyboard Robot</name>
    <description>
        Kontroler Robot Keyboard Arduino Nano via USB OTG secara langsung.
    </description>
    <author email="admin@nanokeyboard.com" href="http://nanokeyboard.com">
        Antigravity Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- Lock orientation to portrait and keep app running on pause -->
    <preference name="KeepRunning" value="true" />
    <preference name="Fullscreen" value="false" />
    <preference name="Orientation" value="portrait" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="www/icon-512.png" />
    </platform>
    
    <!-- Memasang driver USB Serial Android Native yang mendukung CH340, CP210x, FTDI, dll -->
    <plugin name="@red-mobile/cordova-plugin-usb-serial" spec="~1.3.4" />
</widget>
